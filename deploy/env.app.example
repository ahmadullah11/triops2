# ---------------------------------------------------------------------------
# ShopLite — application environment (TEMPLATE)
#
# Goes on the SERVER at /opt/shoplite/.env.app with  chmod 600
# Used by: catalog, inventory, order   (NOT postgres, NOT frontend)
#
# Only the variables the code actually reads are listed. Defaults in brackets
# come from the source, so leaving a line out means "use the default".
# ---------------------------------------------------------------------------

# --- Database connection ---------------------------------------------------
# DB_HOST must be the Docker DNS name, not localhost: the containers are
# separate namespaces, so 127.0.0.1 inside catalog is catalog itself.
DB_HOST=postgres                              # [localhost]
DB_PORT=5432                                  # [5432]
DB_NAME=shopdb                                # [shopdb]
DB_USER=shop                                  # [shop]

# REQUIRED. Same value as POSTGRES_PASSWORD in .env.db, otherwise the server
# rejects the connection with "password authentication failed".
# Generate with:  openssl rand -base64 24
DB_PASSWORD=__REPLACE_WITH_LONG_RANDOM_VALUE__

# --- Service discovery (Docker DNS on backend-net) -------------------------
CATALOG_URL=http://catalog:3000               # [http://localhost:3000]
INVENTORY_URL=http://inventory:8081           # [http://localhost:8081]

# --- Do NOT add PORT here --------------------------------------------------
# PORT is read by all three services. Setting PORT=8082 in a shared file would
# make catalog and inventory try to bind 8082 as well and crash-loop with
# "address already in use". Each image already defaults to its own port:
# catalog 3000, inventory 8081, order 8082. Override per container with `-e`.
