# ---------------------------------------------------------------------------
# ShopLite — PostgreSQL environment (TEMPLATE)
#
# Goes on the SERVER at /opt/shoplite/.env.db with  chmod 600
# Used by: postgres ONLY.
#
# The postgres image reads these three variables on FIRST initialisation of an
# empty data directory. If you change them later on an existing volume, the
# container still contains the OLD role and the new values are ignored —
# that is the classic "access denied after rotating the password" trap.
# ---------------------------------------------------------------------------

POSTGRES_DB=shopdb
POSTGRES_USER=shop

# REQUIRED. Generate on the server, never paste it into a chat or a commit:
#   openssl rand -base64 24
POSTGRES_PASSWORD=__REPLACE_WITH_LONG_RANDOM_VALUE__

# Must match DB_DBNAME / DB_USER / DB_PASSWORD in .env.app
