# Frontend build-time configuration (PUBLIC — ships to the browser).
#
# Leave empty for same-origin requests through Nginx (/api/...).
# Set it only when the API lives on another origin, e.g.
#   VITE_API_BASE_URL=https://api.example.com
# Never add secrets here: Vite inlines VITE_* values into the JS bundle.
VITE_API_BASE_URL=
